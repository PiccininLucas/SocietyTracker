# ==============================================================================
# SocietyTracker - Variáveis de Ambiente & Configurações
# ==============================================================================
# Copie este arquivo para .env e preencha com as credenciais do seu projeto Supabase
# e o PIN numérico desejado para o Modo Mesário.

# URL pública do projeto Supabase (Configurações da API no Supabase Dashboard)
PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave Pública / Publicável do Supabase (Frontend / Navegador / Leituras Públicas)
# Nota: Compatível também com o nome legado PUBLIC_SUPABASE_ANON_KEY
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua-chave-publicavel-aqui

# Chave Secreta do Supabase (Apenas Servidor/SSR - Permissões de escrita / Bypass RLS)
# ATENÇÃO: NUNCA exponha esta chave no frontend/navegador!
# Nota: Compatível também com o nome legado SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SECRET_KEY=sua-chave-secreta-aqui

# PIN para autenticação do mesário no campo
ADMIN_PIN=0000

# Segredo usado para assinar o token de sessão do mesário (HMAC-SHA256).
# OBRIGATÓRIO em produção: sem ele o código cai num valor padrão que está versionado
# neste repositório, e a segurança do token passa a depender só do sigilo do PIN.
# Gere um valor aleatório longo, por exemplo:  openssl rand -base64 48
SESSION_SECRET=troque-por-um-valor-aleatorio-longo
