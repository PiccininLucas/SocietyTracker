# ==============================================================================
# SocietyTracker - Variáveis de Ambiente & Configurações
# ==============================================================================
# Copie este arquivo para .env e preencha com as credenciais do seu projeto Supabase
# e o PIN numérico desejado para o Modo Mesário.

# URL pública do projeto Supabase (Configurações da API no Supabase Dashboard)
PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave Anônima Pública do Supabase (Acesso do lado do cliente / SSR público)
PUBLIC_SUPABASE_ANON_KEY=sua-chave-anonima

# Chave de Serviço do Supabase (Apenas Servidor/SSR - Permissões completas de escrita)
SUPABASE_SERVICE_ROLE_KEY=sua-chave-de-servico-aqui

# PIN de 4 dígitos para autenticação do mesário no campo
ADMIN_PIN=0000
