---
import Layout from '../layouts/Layout.astro';
import MatchHistoryCard from '../components/ui/MatchHistoryCard.astro';
import { MatchDetailsModal } from '../components/ui/MatchDetailsModal';
import { SupabaseMatchRepository } from '../core/infrastructure/repositories/SupabaseMatchRepository';
import type { MatchSummary } from '../core/domain/repositories/IMatchRepository';
import { SupabaseHistoricalRepository } from '../core/infrastructure/repositories/SupabaseHistoricalRepository';
import type { HistoricalPlayerTotal } from '../core/domain/entities/HistoricalPlayerTotal';
import HistoricalTotals from '../components/stats/HistoricalTotals.astro';

export const prerender = false;

let matches: MatchSummary[] = [];
let errorMessage = '';
let historicalTotals: HistoricalPlayerTotal[] = [];

try {
  const matchRepo = new SupabaseMatchRepository();
  const [dbMatches, historical] = await Promise.all([
    matchRepo.getMatchesSummary(), new SupabaseHistoricalRepository().findAll(),
  ]);
  historicalTotals = historical;

  if (dbMatches && dbMatches.length > 0) {
    matches = dbMatches;
  }
} catch {
  errorMessage = 'Não foi possível carregar o histórico. Tente novamente.';
  matches = [];
}

// Fallback de demonstração via query param ?demo quando o banco estiver vazio
if (matches.length === 0 && Astro.url.searchParams.has('demo')) {
  matches = [
    {
      matchId: 'demo-match-1',
      sessionId: 'demo-session-1',
      sessionDate: '2026-09-03',
      homeTeamId: 't-preto',
      homeTeamName: 'Time Finazzi',
      homeTeamColor: '#10b981',
      homeScore: 2,
      awayTeamId: 't-branco',
      awayTeamName: 'Time Chitão',
      awayTeamColor: '#ef4444',
      awayScore: 1,
      durationSeconds: 29,
      endReason: 'two_goals',
      status: 'finished',
      startedAt: '2026-09-03T18:39:00.000Z',
      finishedAt: '2026-09-03T18:39:29.000Z',
      events: [
        {
          id: 'ev-1',
          matchId: 'demo-match-1',
          teamId: 't-preto',
          scorerId: 'p-pedro',
          scorerName: 'Pedro',
          assistId: 'p-chico',
          assistName: 'Chico',
          eventTimeSeconds: 12,
          isOwnGoal: false,
        },
        {
          id: 'ev-2',
          matchId: 'demo-match-1',
          teamId: 't-branco',
          scorerId: 'p-chitao',
          scorerName: 'Chitão',
          eventTimeSeconds: 18,
          isOwnGoal: false,
        },
        {
          id: 'ev-3',
          matchId: 'demo-match-1',
          teamId: 't-preto',
          scorerId: 'p-pedro',
          scorerName: 'Pedro',
          assistId: 'p-finazzi',
          assistName: 'Finazzi',
          eventTimeSeconds: 29,
          isOwnGoal: false,
        },
      ],
      homePlayers: [
        {
          id: 'p-finazzi',
          name: 'Finazzi da Silva',
          nickname: 'Finazzi',
          avatarUrl: null,
          isCaptain: true,
          isGoalkeeper: false,
          isLoaned: false,
          goals: 0,
          assists: 1,
        },
        {
          id: 'p-pedro',
          name: 'Pedro Henrique',
          nickname: 'Pedro',
          avatarUrl: null,
          isCaptain: false,
          isGoalkeeper: false,
          isLoaned: false,
          goals: 2,
          assists: 0,
        },
        {
          id: 'p-chico',
          name: 'Francisco Costa',
          nickname: 'Chico',
          avatarUrl: null,
          isCaptain: false,
          isGoalkeeper: false,
          isLoaned: true,
          goals: 0,
          assists: 1,
        },
        {
          id: 'p-goleiro-1',
          name: 'Diego Alves',
          nickname: 'Diego',
          avatarUrl: null,
          isCaptain: false,
          isGoalkeeper: true,
          isLoaned: false,
          goals: 0,
          assists: 0,
        },
      ],
      awayPlayers: [
        {
          id: 'p-chitao',
          name: 'Chitãozinho Ferreira',
          nickname: 'Chitão',
          avatarUrl: null,
          isCaptain: true,
          isGoalkeeper: false,
          isLoaned: false,
          goals: 1,
          assists: 0,
        },
        {
          id: 'p-buzz',
          name: 'Lucas Buzz',
          nickname: 'Buzz',
          avatarUrl: null,
          isCaptain: false,
          isGoalkeeper: false,
          isLoaned: false,
          goals: 0,
          assists: 0,
        },
        {
          id: 'p-goleiro-2',
          name: 'Weverton Santos',
          nickname: 'Weverton',
          avatarUrl: null,
          isCaptain: false,
          isGoalkeeper: true,
          isLoaned: false,
          goals: 0,
          assists: 0,
        },
      ],
    },
    {
      matchId: 'demo-match-2',
      sessionId: 'demo-session-1',
      sessionDate: '2026-09-03',
      homeTeamId: 't-azul',
      homeTeamName: 'Time Paulinho',
      homeTeamColor: '#3b82f6',
      homeScore: 0,
      awayTeamId: 't-amarelo',
      awayTeamName: 'Time Gabriel',
      awayTeamColor: '#f59e0b',
      awayScore: 0,
      durationSeconds: 420,
      endReason: 'time_limit',
      status: 'finished',
      startedAt: '2026-09-03T18:45:00.000Z',
      finishedAt: '2026-09-03T18:52:00.000Z',
      events: [],
      homePlayers: [
        {
          id: 'p-paulinho',
          name: 'Paulo Silva',
          nickname: 'Paulinho',
          avatarUrl: null,
          isCaptain: true,
          isGoalkeeper: false,
          isLoaned: false,
          goals: 0,
          assists: 0,
        },
        {
          id: 'p-goleiro-3',
          name: 'Alisson Becker',
          nickname: 'Alisson',
          avatarUrl: null,
          isCaptain: false,
          isGoalkeeper: true,
          isLoaned: false,
          goals: 0,
          assists: 0,
        },
      ],
      awayPlayers: [
        {
          id: 'p-gabriel',
          name: 'Gabriel Souza',
          nickname: 'Gabriel',
          avatarUrl: null,
          isCaptain: true,
          isGoalkeeper: false,
          isLoaned: false,
          goals: 0,
          assists: 0,
        },
      ],
    },
  ];
}

// Os times são recriados por rodada: agrupa pelo nome, sem distinguir o mando.
const matchupNames = (match: MatchSummary) =>
  [match.homeTeamName.trim(), match.awayTeamName.trim()].sort();
const matchupKey = (match: MatchSummary) => JSON.stringify(matchupNames(match));
const matchups = Array.from(
  new Map(matches.map((match) => [matchupKey(match), matchupNames(match).join(' × ')])),
  ([value, label]) => ({ value, label })
).sort((a, b) => a.label.localeCompare(b.label, 'pt-BR'));

const requestedMatchup = Astro.url.searchParams.get('confronto') || '';
const selectedMatchup = matchups.some(({ value }) => value === requestedMatchup) ? requestedMatchup : '';
const requestedDate = Astro.url.searchParams.get('data') || '';
const parsedDate = new Date(`${requestedDate}T12:00:00Z`);
const selectedDate = /^\d{4}-\d{2}-\d{2}$/.test(requestedDate)
  && !Number.isNaN(parsedDate.getTime())
  && parsedDate.toISOString().slice(0, 10) === requestedDate ? requestedDate : '';
const hasFilters = Boolean(selectedMatchup || selectedDate);
const filteredMatches = matches.filter((match) =>
  (!selectedMatchup || matchupKey(match) === selectedMatchup)
  && (!selectedDate || match.sessionDate === selectedDate)
);
const clearFiltersUrl = Astro.url.searchParams.has('demo') ? `${Astro.url.pathname}?demo` : Astro.url.pathname;

// Agrupamento por data da sessão, após aplicar ambos os filtros.
const groupedMatches = filteredMatches.reduce(
  (acc, match) => {
    const dateKey = match.sessionDate || 'Data Não Informada';
    if (!acc[dateKey]) {
      acc[dateKey] = [];
    }
    acc[dateKey].push(match);
    return acc;
  },
  {} as Record<string, MatchSummary[]>
);

const formatDate = (dateStr: string) => {
  try {
    const parts = dateStr.split('-');
    if (parts.length === 3) {
      const year = parseInt(parts[0], 10);
      const month = parseInt(parts[1], 10) - 1;
      const day = parseInt(parts[2], 10);
      const date = new Date(year, month, day);
      return date.toLocaleDateString('pt-BR', {
        weekday: 'long',
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      });
    }
    return dateStr;
  } catch {
    return dateStr;
  }
};
---

<Layout
  title="SocietyTracker • Histórico de Partidas"
  description="Veja o placar, duração e detalhes de todos os confrontos disputados nas quintas-feiras."
  activeNav="historico"
>
  {errorMessage && <p role="alert" class="text-rose-300 border border-rose-400 p-4 rounded-xl">{errorMessage}<a href={Astro.url.pathname+Astro.url.search} class="block min-h-[44px] underline">Tentar novamente</a></p>}
  <div class="space-y-8">
    <!-- Header da Página de Histórico -->
    <div class="p-6 sm:p-8 rounded-3xl glass-card bg-surface-100/90 border border-white/10 shadow-2xl flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs font-black uppercase tracking-wider mb-2">
          <span>📜</span>
          <span>Linha do Tempo</span>
        </div>
        <h1 class="font-display font-black text-2xl sm:text-3xl lg:text-4xl text-white">
          Histórico de Confrontos
        </h1>
        <p class="text-xs sm:text-sm text-gray-400 mt-1">
          Resultados e lances detalhados de cada rodada da quinta-feira
        </p>
      </div>

      <div class="flex items-center gap-3 text-xs font-semibold text-gray-300">
        <span class="px-3.5 py-2 rounded-2xl bg-surface-50 border border-white/5 shadow">
          ⚽ {filteredMatches.reduce((acc, m) => acc + m.homeScore + m.awayScore, 0)} Gols Marcados
        </span>
        <span class="px-3.5 py-2 rounded-2xl bg-surface-50 border border-white/5 shadow">
          🎮 {filteredMatches.length} Partidas
        </span>
      </div>
    </div>

    <form method="get" action={Astro.url.pathname} aria-label="Filtrar histórico" class="p-5 sm:p-6 rounded-3xl glass-card bg-surface-100/90 border border-white/10 space-y-4">
      {Astro.url.searchParams.has('demo') && <input type="hidden" name="demo" value="" />}
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-[minmax(0,1fr)_220px_auto] items-end gap-4">
        <div class="min-w-0">
          <label for="history-matchup" class="block text-sm font-semibold text-gray-300">Confronto</label>
          <select id="history-matchup" name="confronto" class="block mt-2 w-full min-w-0 min-h-[44px] rounded-xl px-3 bg-surface-200 border border-white/15 text-sm text-white focus:outline-none focus:ring-2 focus:ring-emerald-400 [color-scheme:dark]">
            <option value="" selected={!selectedMatchup}>Todos os confrontos</option>
            {matchups.map(({ value, label }) => <option value={value} selected={selectedMatchup === value}>{label}</option>)}
          </select>
        </div>
        <div class="min-w-0">
          <label for="history-date" class="block text-sm font-semibold text-gray-300">Data da rodada</label>
          <input id="history-date" type="date" name="data" value={selectedDate} class="block mt-2 w-full min-w-0 min-h-[44px] rounded-xl px-3 bg-surface-200 border border-white/15 text-sm text-white focus:outline-none focus:ring-2 focus:ring-emerald-400 [color-scheme:dark]" />
        </div>
        <div class="flex flex-wrap items-center gap-3 sm:col-span-2 lg:col-span-1">
          <button type="submit" class="min-h-[44px] flex-1 sm:flex-none rounded-xl px-5 bg-emerald-500 hover:bg-emerald-400 text-gray-950 text-sm font-bold transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-emerald-400 focus-visible:outline-offset-4">Aplicar filtros</button>
          {hasFilters && <a href={clearFiltersUrl} class="inline-flex items-center justify-center min-h-[44px] px-3 rounded-xl text-sm font-semibold text-gray-300 hover:text-white hover:bg-white/5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-emerald-400">Limpar filtros</a>}
        </div>
      </div>
      <p class="text-xs text-gray-400" role="status">
        {hasFilters ? `Exibindo ${filteredMatches.length} de ${matches.length} partidas. Os totais consideram os filtros aplicados.` : 'Selecione um confronto, uma data ou combine os dois filtros.'}
      </p>
    </form>

    <HistoricalTotals totals={historicalTotals} />

    <!-- Lista de Sessões Agrupadas por Data -->
    <div class="space-y-8">
      {matches.length === 0 ? (
        <div class="p-12 text-center rounded-3xl glass-card bg-surface-100/90 border border-white/10 shadow-2xl flex flex-col items-center justify-center gap-3">
          <span class="text-4xl">📜</span>
          <h3 class="font-display font-bold text-lg text-white">Nenhum confronto realizado ainda</h3>
          <p class="text-xs sm:text-sm text-gray-400 max-w-md">
            O histórico de partidas, placares e tempos será preenchido automaticamente à medida que as partidas forem concluídas na área do mesário.
          </p>
        </div>
      ) : filteredMatches.length === 0 ? (
        <div class="p-8 sm:p-12 text-center rounded-3xl glass-card bg-surface-100/90 border border-white/10 flex flex-col items-center gap-3">
          <span class="text-4xl" aria-hidden="true">🔎</span>
          <h3 class="font-display font-bold text-lg text-white">Nenhum confronto encontrado</h3>
          <p class="text-xs sm:text-sm text-gray-400 max-w-md">Não há partidas para os filtros selecionados. Escolha outro confronto ou outra data.</p>
          <a href={clearFiltersUrl} class="inline-flex items-center min-h-[44px] px-4 rounded-xl text-sm font-bold text-emerald-400 hover:bg-emerald-500/10">Ver todo o histórico</a>
        </div>
      ) : (
        Object.entries(groupedMatches).map(([dateStr, sessionMatches]) => {
          const totalSessionGoals = sessionMatches.reduce((acc, m) => acc + m.homeScore + m.awayScore, 0);

          return (
            <section class="space-y-4">
              <!-- Header da Sessão / Data -->
              <div class="flex items-center justify-between gap-2 px-2 pb-2 border-b border-white/10">
                <div class="flex items-center gap-2.5">
                  <span class="w-3 h-3 rounded-full bg-emerald-400 shadow shadow-emerald-500/50"></span>
                  <h2 class="font-display font-black text-base sm:text-lg text-white capitalize">
                    {formatDate(dateStr)}
                  </h2>
                </div>

                <div class="flex items-center gap-2 text-xs text-gray-400 font-semibold">
                  <span>{sessionMatches.length} jogos</span>
                  <span>•</span>
                  <span class="text-emerald-400">{totalSessionGoals} gols</span>
                </div>
              </div>

              <!-- Grid de Confrontos daquela Data -->
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                {sessionMatches.map((match) => (
                  <MatchHistoryCard match={match} />
                ))}
              </div>
            </section>
          );
        })
      )}
    </div>
  </div>

  <!-- Modal Interativo de Detalhes da Partida e Escalações -->
  <MatchDetailsModal client:load matches={matches} />
  {Astro.url.searchParams.has('apagada') && <p role="status" class="p-4 text-emerald-300">Partida apagada. Histórico e estatísticas atualizados.</p>}
  <script>
    window.addEventListener('match-deleted', () => {
      const url = new URL(location.href);
      url.searchParams.delete('match');
      url.searchParams.set('apagada', '1');
      location.replace(url);
    });
  </script>
</Layout>
