import { SupabaseMatchRepository } from '../core/infrastructure/repositories/SupabaseMatchRepository';
import type { MatchSummary } from '../core/domain/repositories/IMatchRepository';

export const prerender = false;

let matches: MatchSummary[] = [];

try {
  const matchRepo = new SupabaseMatchRepository();
  const dbMatches = await matchRepo.getMatchesSummary();

  if (dbMatches && dbMatches.length > 0) {
    matches = dbMatches;
  }
} catch {
  matches = [];
}

