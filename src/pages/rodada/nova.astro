---
import Layout from '../../layouts/Layout.astro';
import { TeamBuilderIsland, type PlayerItem } from '../../components/live/TeamBuilderIsland';
import { SupabasePlayerRepository } from '../../core/infrastructure/repositories/SupabasePlayerRepository';
import { NO_STORE } from '../../core/infrastructure/http/api';

export const prerender = false;

let players: PlayerItem[] = [];

try {
  const playerRepo = new SupabasePlayerRepository();
  const dbPlayers = await playerRepo.findAll(true);

  if (dbPlayers && dbPlayers.length > 0) {
    players = dbPlayers.map((p) => ({
      id: p.id || '',
      name: p.name,
      nickname: p.nickname || null,
      avatarUrl: p.avatarUrl || null,
      isGoalkeeper: p.isGoalkeeper ?? false,
    }));
  }
} catch {
  players = [];
  // O service worker não guarda a tela vazia no lugar da cópia com os jogadores.
  Astro.response.headers.set('Cache-Control', NO_STORE);
}
---

<Layout
  title="SocietyTracker • Montar Times da Rodada"
  description="Distribua os atletas presentes nos 3 ou 4 times da noite e inicie a pelada com tempo configurável!"
  activeNav="nova_rodada"
>
  <TeamBuilderIsland client:load initialPlayers={players} />
</Layout>
