---
import Layout from '../layouts/Layout.astro';
import PodiumCard from '../components/ui/PodiumCard.astro';
import { TeamStandings } from '../components/stats/TeamStandings';
import { PlayerPerformanceTable } from '../components/stats/PlayerPerformanceTable';
import { SupabaseSessionRepository } from '../core/infrastructure/repositories/SupabaseSessionRepository';
import { SupabasePlayerRepository } from '../core/infrastructure/repositories/SupabasePlayerRepository';
import {
  playerPerformance,
  weekRange,
  type PlayerPerformance,
} from '../core/domain/services/CompetitionService';
import type { MatchSummary } from '../core/domain/repositories/IMatchRepository';
import { SupabaseMatchRepository } from '../core/infrastructure/repositories/SupabaseMatchRepository';
import type { LeaderboardItemDTO } from '../core/application/dtos/LeaderboardDTO';

export const prerender = false;

let leaderboard: LeaderboardItemDTO[] = [];
const season = Astro.url.searchParams.get('season') ?? String(new Date().getFullYear());
const sort = Astro.url.searchParams.get('sort') ?? 'contributions';
const direction = Astro.url.searchParams.get('direction') ?? 'desc';
let totalGoalsAll = 0;
let errorMessage = '',
  selectedWeek = Astro.url.searchParams.get('week') ?? '';
let years: string[] = [String(new Date().getFullYear())],
  weeklyMatches: MatchSummary[] = [],
  performance: PlayerPerformance[] = [];
let weeklyTeams: { id: string; name: string; colorHex: string }[] = [];
let weekLabel = '';
try {
  const matchRepo = new SupabaseMatchRepository();
  const [matches, sessions, players] = await Promise.all([
    matchRepo.getMatchesSummary(),
    new SupabaseSessionRepository().findAll(),
    new SupabasePlayerRepository().findAll(),
  ]);
  years = [...new Set([...years, ...sessions.map((s) => s.sessionDate.slice(0, 4))])]
    .sort()
    .reverse();
  if (!selectedWeek)
    selectedWeek = sessions[0]?.sessionDate ?? new Date().toISOString().slice(0, 10);
  const range = weekRange(selectedWeek);
  weekLabel =
    range.start.split('-').reverse().join('/') + ' a ' + range.end.split('-').reverse().join('/');
  weeklyMatches = matches.filter((m) => m.sessionDate >= range.start && m.sessionDate <= range.end);
  const weekSessions = sessions.filter(
    (s) => s.sessionDate >= range.start && s.sessionDate <= range.end
  );
  weeklyTeams = weekSessions.flatMap((s) =>
    s.teams.map((t) => ({
      id: t.id!,
      name:
        t.name +
        (weekSessions.length > 1 ? ' · ' + s.sessionDate.split('-').reverse().join('/') : ''),
      colorHex: t.colorHex,
    }))
  );
  const seasonal = matches.filter((m) => season === 'all' || m.sessionDate.slice(0, 4) === season);
  totalGoalsAll = seasonal
    .filter((m) => m.status === 'finished')
    .reduce((sum, m) => sum + m.homeScore + m.awayScore, 0);
  performance = playerPerformance(
    seasonal,
    players.map((p) => ({
      id: p.id!,
      name: p.name,
      nickname: p.nickname,
      avatarUrl: p.avatarUrl,
      isActive: p.isActive,
    }))
  );
  leaderboard = performance.map((p) => ({
    playerId: p.playerId,
    name: p.name,
    nickname: p.nickname,
    displayName: p.nickname || p.name,
    avatarUrl: p.avatarUrl,
    totalGoals: p.goals,
    totalAssists: p.assists,
    totalContributions: p.contributions,
    totalMatchesPlayed: p.played,
    totalSessionsPlayed: p.sessions,
    goalsPerMatch: p.played ? p.goals / p.played : 0,
  }));
} catch (e) {
  errorMessage = e instanceof Error ? e.message : 'Não foi possível carregar as estatísticas.';
}
// Estatísticas Agregadas

const totalAssistsAll = leaderboard.reduce((acc, p) => acc + (p.totalAssists || 0), 0);

// Top 3 do Pódio:
const sortedByGoals = [...leaderboard].sort((a, b) => b.totalGoals - a.totalGoals);
const topScorer = sortedByGoals[0];

const sortedByAssists = [...leaderboard].sort((a, b) => b.totalAssists - a.totalAssists);
const topAssister = sortedByAssists[0];

const sortedByContributions = [...leaderboard].sort(
  (a, b) => b.totalContributions - a.totalContributions
);
const topContributor = sortedByContributions[0];
const hasPodium = leaderboard.some((p) => p.totalContributions > 0);
---

<Layout
  title="SocietyTracker • Tabela de Classificação & Artilharia"
  description="Confira o ranking de artilharia, assistências e estatísticas completas da Pelada das Quintas!"
  activeNav="leaderboard"
>
  <div class="space-y-8">
    <!-- Hero Header -->
    <div class="relative overflow-hidden rounded-3xl glass-card bg-gradient-to-r from-emerald-950/40 via-surface-100 to-surface-200 p-6 sm:p-8 border border-white/10 shadow-2xl">
      <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-black uppercase tracking-wider mb-3">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>Temporada Oficial</span>
          </div>

          <h1 class="font-display font-black text-3xl sm:text-4xl lg:text-5xl text-white tracking-tight">
            Pelada das <span class="bg-gradient-to-r from-emerald-400 to-teal-300 bg-clip-text text-transparent">Quintas</span>
          </h1>
          <p class="text-sm sm:text-base text-gray-400 mt-2 max-w-xl">
            Tabela oficial de artilharia, garçons e participações diretas. Tempo regulamentar com encerramento pelo mesário; vitória automática aos 2 gols.
          </p>
        </div>

        <!-- Badges Rápidas de Estatísticas -->
        <div class="flex items-center gap-3 shrink-0">
          <div class="p-3.5 sm:p-4 rounded-2xl bg-surface-50/80 border border-white/10 text-center min-w-[90px] shadow-lg">
            <span class="font-display font-black text-2xl sm:text-3xl text-emerald-400">{totalGoalsAll}</span>
            <span class="block text-[10px] sm:text-xs font-bold uppercase tracking-wider text-gray-400 mt-0.5">Gols</span>
          </div>

          <div class="p-3.5 sm:p-4 rounded-2xl bg-surface-50/80 border border-white/10 text-center min-w-[90px] shadow-lg">
            <span class="font-display font-black text-2xl sm:text-3xl text-blue-400">{totalAssistsAll}</span>
            <span class="block text-[10px] sm:text-xs font-bold uppercase tracking-wider text-gray-400 mt-0.5">Assists</span>
          </div>

          <div class="p-3.5 sm:p-4 rounded-2xl bg-surface-50/80 border border-white/10 text-center min-w-[90px] shadow-lg">
            <span class="font-display font-black text-2xl sm:text-3xl text-amber-400">{leaderboard.length}</span>
            <span class="block text-[10px] sm:text-xs font-bold uppercase tracking-wider text-gray-400 mt-0.5">Atletas</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Pódio Visual: Top 3 Destaques da Temporada (Exibido apenas quando houver partidas) -->
    {hasPodium && topScorer && topAssister && topContributor && (
      <div>
        <div class="flex items-center justify-between gap-2 mb-4 px-1">
          <h2 class="font-display font-black text-xl sm:text-2xl text-white flex items-center gap-2">
            <span>👑</span>
            <span>Destaques da Pelada</span>
          </h2>
          <span class="text-xs text-gray-400 font-semibold">Os líderes da temporada</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6 items-end">
          <!-- 2º Lugar: Garçom de Ouro -->
          <div class="order-2 md:order-1">
            <PodiumCard
              rank={2}
              title="Garçom da Pelada"
              category="garcom"
              playerName={topAssister.name}
              playerNickname={topAssister.nickname}
              avatarUrl={topAssister.avatarUrl}
              statValue={topAssister.totalAssists}
              statLabel="Assistências"
              secondaryStat={`${topAssister.totalGoals} gols anotados`}
            />
          </div>

          <!-- 1º Lugar: Artilheiro / Chuteira de Ouro (Central) -->
          <div class="order-1 md:order-2">
            <PodiumCard
              rank={1}
              title="Chuteira de Ouro"
              category="artilheiro"
              playerName={topScorer.name}
              playerNickname={topScorer.nickname}
              avatarUrl={topScorer.avatarUrl}
              statValue={topScorer.totalGoals}
              statLabel="Gols Marcados"
              secondaryStat={`Média de ${topScorer.goalsPerMatch.toFixed(2)} gols/jogo (${topScorer.totalMatchesPlayed} jogos)`}
            />
          </div>

          <!-- 3º Lugar: Destaque Geral G+A -->
          <div class="order-3 md:order-3">
            <PodiumCard
              rank={3}
              title="Rei da Pelada (G+A)"
              category="destaque"
              playerName={topContributor.name}
              playerNickname={topContributor.nickname}
              avatarUrl={topContributor.avatarUrl}
              statValue={topContributor.totalContributions}
              statLabel="Participações"
              secondaryStat={`${topContributor.totalGoals}G + ${topContributor.totalAssists}A`}
            />
          </div>
        </div>
      </div>
    )}

    <!-- Tabela Geral de Classificação SSR -->
    <form method="GET" class="glass-card rounded-2xl p-4 flex flex-wrap gap-4 items-end">
 <label class="block text-sm">Temporada<select name="season" class="block mt-1 min-h-[44px] rounded-xl px-3 bg-surface-200 border border-white/20">{years.map(year=><option value={year} selected={season===year}>{year}</option>)}<option value="all" selected={season==='all'}>Todo o histórico</option></select></label>
 <label class="block text-sm">Semana que inclui<input type="date" name="week" value={selectedWeek} class="block mt-1 min-h-[44px] rounded-xl px-3 bg-surface-200 border border-white/20" /></label>
 <button class="min-h-[44px] rounded-xl px-4 bg-emerald-500 text-gray-950 font-bold">Aplicar filtros</button>
</form>
{errorMessage&&<div role="alert" class="text-rose-300 rounded-xl border border-rose-500 p-4">{errorMessage}<a href={Astro.url.pathname+Astro.url.search} class="block py-3 underline">Tentar novamente</a></div>}
<TeamStandings matches={weeklyMatches} teams={weeklyTeams} scope={'Semana selecionada: '+weekLabel+' · somente partidas finalizadas'} />
<PlayerPerformanceTable players={performance} season={season} sort={sort} direction={direction} week={selectedWeek} />
  </div>
</Layout>
