---
import '../styles/globals.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  // 'none': página fora da navegação, como a /offline.
  activeNav?: 'leaderboard' | 'historico' | 'relatorios' | 'nova_rodada' | 'mesario' | 'none';
}

const {
  title = 'SocietyTracker • Pelada das Quintas',
  description = 'Acompanhe a artilharia, garçons, estatísticas e o placar ao vivo da pelada society de quinta-feira!',
  image = '/og-society-tracker.png',
  activeNav = 'leaderboard',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://society-tracker-smoky.vercel.app');
// O Layout não lê cookie nenhum: o HTML sai igual para todo visitante, o que deixa as
// páginas públicas irem para a CDN (PUBLIC_CACHE_CONTROL). O que muda com o login, como
// o botão "Sair", é resolvido no navegador pelo script do fim da página.
---

<!doctype html>
<html lang="pt-BR" class="dark scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#090d16" />
    <!-- PWA: instalável na tela inicial; o service worker (public/sw.js) abre sem sinal. -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Society" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <!-- SEO Primary Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / WhatsApp Preview Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="SocietyTracker" />
    <meta property="og:locale" content="pt_BR" />

    <!-- Twitter Card Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Outfit:wght@600;700;800;900&family=JetBrains+Mono:wght@500;700;800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="bg-background text-gray-100 min-h-screen flex flex-col antialiased selection:bg-emerald-500/30 selection:text-emerald-200">
    <!-- Background Pitch Ambient Glow -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
      <div class="absolute -top-40 -left-40 w-96 h-96 bg-emerald-600/10 rounded-full blur-3xl"></div>
      <div class="absolute top-1/3 -right-40 w-96 h-96 bg-blue-600/10 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-40 left-1/3 w-96 h-96 bg-amber-500/5 rounded-full blur-3xl"></div>
    </div>

    <!-- Header Superior (Desktop e Tablets) -->
    <!-- Instalado no iPhone, a barra de status é translúcida e fica por cima da página: o
         padding da área segura desce o cabeçalho para baixo dela. No navegador vale 0. -->
    <header
      class="sticky top-0 z-40 w-full glass-card border-b border-white/5 bg-background/80 backdrop-blur-md"
      style="padding-top: env(safe-area-inset-top, 0px)"
    >
      <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
        <!-- Logo & Marca -->
        <a href="/" class="min-h-[44px] flex items-center gap-2.5 group">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-emerald-400 to-emerald-600 flex items-center justify-center text-gray-950 font-black text-lg shadow-lg shadow-emerald-500/20 group-hover:scale-105 transition-transform">
            ⚽
          </div>
          <div>
            <div class="flex items-center gap-1.5">
              <span class="font-display font-black text-lg tracking-tight text-white group-hover:text-emerald-400 transition-colors">
                Society<span class="text-emerald-400">Tracker</span>
              </span>
              <span class="text-[10px] font-black uppercase px-1.5 py-0.5 rounded bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 tracking-wider">
                Quintas
              </span>
            </div>
            <p class="text-[10px] text-gray-400 -mt-0.5 hidden sm:block">Estatísticas & Placar da Pelada</p>
          </div>
        </a>

        <!-- Desktop Navigation Links -->
        <nav class="hidden md:flex items-center gap-1">
          <a
            href="/"
            class:list={[
              'px-3.5 py-2 rounded-xl text-sm font-bold transition-all flex items-center gap-2',
              activeNav === 'leaderboard'
                ? 'bg-emerald-500/15 text-emerald-300 border border-emerald-500/30'
                : 'text-gray-400 hover:text-white hover:bg-white/5',
            ]}
          >
            <span>🏆</span>
            <span>Classificação</span>
          </a>

          <a
            href="/historico"
            class:list={[
              'px-3.5 py-2 rounded-xl text-sm font-bold transition-all flex items-center gap-2',
              activeNav === 'historico'
                ? 'bg-emerald-500/15 text-emerald-300 border border-emerald-500/30'
                : 'text-gray-400 hover:text-white hover:bg-white/5',
            ]}
          >
            <span>📜</span>
            <span>Histórico</span>
          </a>

          <a
            href="/relatorios"
            class:list={[
              'px-3.5 py-2 rounded-xl text-sm font-bold transition-all flex items-center gap-2',
              activeNav === 'relatorios'
                ? 'bg-emerald-500/15 text-emerald-300 border border-emerald-500/30'
                : 'text-gray-400 hover:text-white hover:bg-white/5',
            ]}
          >
            <span>📸</span>
            <span>Relatórios</span>
          </a>

          <a
            href="/rodada/nova"
            class:list={[
              'px-3.5 py-2 rounded-xl text-sm font-bold transition-all flex items-center gap-2',
              activeNav === 'nova_rodada'
                ? 'bg-emerald-500/15 text-emerald-300 border border-emerald-500/30'
                : 'text-gray-400 hover:text-white hover:bg-white/5',
            ]}
          >
            <span>👥</span>
            <span>Montar Times</span>
          </a>
        </nav>

        <!-- Ação Rápida Mesário / Logout -->
        <div class="flex items-center gap-2">
          <button
            type="button"
            id="btn-logout"
            hidden
            class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-surface-50 hover:bg-rose-500/20 text-gray-400 hover:text-rose-300 border border-white/5 text-xs font-semibold transition-colors"
            title="Sair da sessão do mesário"
          >
            <span>🔒</span>
            <span>Sair</span>
          </button>

          <a
            href="/rodada/mesario"
            class:list={[
              'relative min-h-[44px] flex items-center gap-2 px-3.5 sm:px-4 py-2 rounded-xl font-bold text-xs sm:text-sm transition-all shadow-md active:scale-95 touch-press-scale',
              activeNav === 'mesario'
                ? 'bg-emerald-500 text-gray-950 shadow-emerald-500/30 ring-2 ring-emerald-400/50'
                : 'bg-emerald-500/15 text-emerald-300 hover:bg-emerald-500/25 border border-emerald-500/30',
            ]}
          >
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400/60"></span>
            <span>Modo Mesário</span>
          </a>
        </div>
      </div>

      <!-- Lances do mesário parados neste aparelho: a fila só é enviada com o mesário aberto.
           Cobre o iPhone, que não pergunta antes de sair, e quem fechou o app. Fica dentro do
           cabeçalho fixo para não sumir ao rolar, nem ao recarregar a página rolada. No
           próprio mesário não aparece: ele mostra a fila. -->
      {activeNav !== 'mesario' && (
        <div
          id="pending-banner"
          hidden
          role="status"
          class="flex flex-wrap items-center justify-center gap-x-3 border-t border-amber-400/40 bg-amber-950/90 px-4 text-center text-sm text-amber-100"
        >
          <span id="pending-banner-text"></span>
          <a id="pending-banner-link" href="/rodada/mesario" class="min-h-[44px] inline-flex items-center font-bold underline">
            Abrir o mesário
          </a>
        </div>
      )}
    </header>

    <div
      id="offline-banner"
      hidden
      role="status"
      class="relative z-30 border-b border-amber-400/40 bg-amber-950/90 px-4 py-2 text-center text-sm text-amber-100"
    >
      Sem conexão. O que está na tela pode estar desatualizado; os lances do mesário ficam neste
      aparelho e são enviados quando o sinal voltar.
    </div>

    <!-- Conteúdo Principal da Página -->
    <main class="relative z-10 flex-1 w-full max-w-6xl mx-auto px-3.5 sm:px-6 py-6 pb-28 md:pb-12">
      <slot />
    </main>

    <!-- Footer Discreto -->
    <footer class="relative z-10 border-t border-white/5 bg-surface-200/50 py-6 text-center text-xs text-gray-500">
      <div class="max-w-6xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-2">
        <p>© {new Date().getFullYear()} SocietyTracker • Pelada das Quintas. Todos os direitos reservados.</p>
        <p class="text-gray-400 font-medium">Finalização pelo mesário ou 2 gols • Sistema Oficial</p>
      </div>
    </footer>

    <!-- Mobile Bottom Navigation Bar (Fixo para Smartphones) -->
    <nav id="mobile-nav" class="md:hidden fixed bottom-0 left-0 right-0 z-50 glass-card bg-surface-200/90 border-t border-white/10 px-3 py-2 pb-safe backdrop-blur-xl">
      <div class="flex items-center justify-around">
        <a
          href="/"
          class:list={[
            'flex flex-col items-center gap-1 py-1 px-3 rounded-xl transition-all',
            activeNav === 'leaderboard' ? 'text-emerald-400 font-bold scale-105' : 'text-gray-400 hover:text-gray-200',
          ]}
        >
          <span class="text-lg">🏆</span>
          <span class="text-[10px] tracking-tight">Ranking</span>
        </a>

        <a
          href="/historico"
          class:list={[
            'flex flex-col items-center gap-1 py-1 px-3 rounded-xl transition-all',
            activeNav === 'historico' ? 'text-emerald-400 font-bold scale-105' : 'text-gray-400 hover:text-gray-200',
          ]}
        >
          <span class="text-lg">📜</span>
          <span class="text-[10px] tracking-tight">Jogos</span>
        </a>

        <a
          href="/relatorios"
          class:list={[
            'flex flex-col items-center gap-1 py-1 px-3 rounded-xl transition-all',
            activeNav === 'relatorios' ? 'text-emerald-400 font-bold scale-105' : 'text-gray-400 hover:text-gray-200',
          ]}
        >
          <span class="text-lg">📸</span>
          <span class="text-[10px] tracking-tight">Relatórios</span>
        </a>

        <a
          href="/rodada/nova"
          class:list={[
            'flex flex-col items-center gap-1 py-1 px-3 rounded-xl transition-all',
            activeNav === 'nova_rodada' ? 'text-emerald-400 font-bold scale-105' : 'text-gray-400 hover:text-gray-200',
          ]}
        >
          <span class="text-lg">👥</span>
          <span class="text-[10px] tracking-tight">Times</span>
        </a>

        <a
          href="/rodada/mesario"
          class:list={[
            'flex flex-col items-center gap-1 py-1 px-3 rounded-xl transition-all relative',
            activeNav === 'mesario' ? 'text-emerald-400 font-bold scale-105' : 'text-gray-400 hover:text-gray-200',
          ]}
        >
          <span class="relative inline-block text-lg">
            ⏱
            <span class="absolute -top-1 -right-1 w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          </span>
          <span class="text-[10px] tracking-tight">Mesário</span>
        </a>
      </div>
    </nav>

    <script>
      import { pendingOnDevice } from '../lib/pendingOnDevice';

      // Mesmo nome de public/sw.js: as páginas guardadas para abrir sem sinal.
      const PAGES_CACHE = 'society-pages-v1';

      // "Sair" pela dica não-HttpOnly que o login grava junto com a sessão (pinAuth).
      const logout = document.getElementById('btn-logout');
      if (logout && document.cookie.split('; ').includes('society_admin_hint=1'))
        logout.hidden = false;
      logout?.addEventListener('click', async () => {
        try {
          if (!(await fetch('/api/auth/logout', { method: 'POST' })).ok) return;
        } catch {
          return;
        }
        // As telas do mesário guardadas no aparelho saem junto com a sessão.
        await window.caches?.delete(PAGES_CACHE).catch(() => false);
        window.location.href = '/';
      });

      const banner = document.getElementById('offline-banner');
      const showConnection = () => {
        if (banner) banner.hidden = navigator.onLine;
      };
      window.addEventListener('online', showConnection);
      window.addEventListener('offline', showConnection);
      showConnection();

      const pendingBanner = document.getElementById('pending-banner');
      const showPending = () => {
        if (!pendingBanner) return;
        let pending: ReturnType<typeof pendingOnDevice> = [];
        try {
          pending = pendingOnDevice(localStorage);
        } catch {
          // Armazenamento bloqueado: não há fila neste aparelho.
        }
        const count = pending.reduce((n, p) => n + p.count, 0);
        pendingBanner.hidden = count === 0;
        if (!count) return;
        const text = document.getElementById('pending-banner-text');
        if (text)
          text.textContent =
            count === 1
              ? 'Há 1 lance deste aparelho ainda não enviado.'
              : `Há ${count} lances deste aparelho ainda não enviados.`;
        const link = document.getElementById('pending-banner-link') as HTMLAnchorElement | null;
        if (link) link.href = '/rodada/mesario?sessionId=' + encodeURIComponent(pending[0].sessionId);
      };
      // storage: o mesário aberto em outra aba enviou a fila. pageshow: volta pelo histórico.
      window.addEventListener('storage', showPending);
      window.addEventListener('pageshow', showPending);
      showPending();

      // Só no build: no `astro dev` o SW guardaria os módulos do Vite e serviria código velho.
      if (import.meta.env.PROD && 'serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          const firstVisit = !navigator.serviceWorker.controller;
          navigator.serviceWorker
            .register('/sw.js')
            .then(() => navigator.serviceWorker.ready)
            .then((registration) => {
              // Na primeira visita a página e o JS dela carregaram antes do SW existir, e
              // a primeira abertura sem sinal viria sem nada. Ele guarda tudo agora.
              if (!firstVisit) return;
              registration.active?.postMessage({
                type: 'cache-page',
                url: location.href,
                assets: performance.getEntriesByType('resource').map((entry) => entry.name),
              });
            })
            .catch(() => {});
        });
      }
    </script>
  </body>
</html>
