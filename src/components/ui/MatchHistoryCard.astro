---
import type { MatchSummary } from '../../core/domain/repositories/IMatchRepository';

export interface Props {
  match: MatchSummary;
}

const { match } = Astro.props;

const events = match.events || [];

const normalizeId = (id?: string | null) => (id ? id.trim().toLowerCase() : '');
const homeTeamId = normalizeId(match.homeTeamId);
const awayTeamId = normalizeId(match.awayTeamId);

// Fonte da verdade: Se existirem eventos carregados, calcula o placar a partir da contagem real de eventos
const calculatedHomeScore = events.filter((e) => {
  const tId = normalizeId(e.teamId);
  return (!e.isOwnGoal && tId === homeTeamId) || (e.isOwnGoal && tId === awayTeamId);
}).length;

const calculatedAwayScore = events.filter((e) => {
  const tId = normalizeId(e.teamId);
  return (!e.isOwnGoal && tId === awayTeamId) || (e.isOwnGoal && tId === homeTeamId);
}).length;

const homeScore = events.length > 0 ? calculatedHomeScore : (match.homeScore ?? 0);
const awayScore = events.length > 0 ? calculatedAwayScore : (match.awayScore ?? 0);

const isHomeWinner = homeScore > awayScore;
const isAwayWinner = awayScore > homeScore;
const isDraw = homeScore === awayScore;

const formatMinutes = (seconds: number) => {
  const mins = Math.floor((seconds ?? 0) / 60);
  const secs = (seconds ?? 0) % 60;
  return `${mins}m ${secs.toString().padStart(2, '0')}s`;
};

const formatTime = (isoString?: string | null) => {
  if (!isoString) return '';
  try {
    const date = new Date(isoString);
    return date.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
  } catch {
    return '';
  }
};

// Separação dos lances por time que foi pontuado (tratando gol contra para o adversário)
const homeEvents = events.filter((e) => {
  const tId = normalizeId(e.teamId);
  return (!e.isOwnGoal && tId === homeTeamId) || (e.isOwnGoal && tId === awayTeamId);
});

const awayEvents = events.filter((e) => {
  const tId = normalizeId(e.teamId);
  return (!e.isOwnGoal && tId === awayTeamId) || (e.isOwnGoal && tId === homeTeamId);
});

const totalGoals = homeScore + awayScore;
const hasEvents = events.length > 0;
---

<div
  class="group cursor-pointer rounded-3xl glass-card border border-white/10 p-5 bg-surface-100/90 shadow-lg hover:border-emerald-500/50 hover:bg-slate-800/60 hover:shadow-xl hover:shadow-emerald-500/5 hover:-translate-y-0.5 transition-all duration-200 select-none relative"
  data-match-card
  data-match-id={match.matchId}
  role="button"
  tabindex="0"
  aria-label={`Ver detalhes e escalações da partida entre ${match.homeTeamName} e ${match.awayTeamName}`}
>
  <!-- Top Bar: Status, End Reason & Horário -->
  <div class="flex items-center justify-between gap-2 mb-4">
    <div class="flex items-center gap-2">
      {match.endReason === 'two_goals' ? (
        <span class="px-2.5 py-0.5 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 text-[11px] font-black uppercase tracking-wider flex items-center gap-1 shadow-sm shadow-emerald-500/10">
          <span>⚡</span>
          <span>Regra dos 2 Gols</span>
        </span>
      ) : match.endReason === 'time_limit' ? (
        <span class="px-2.5 py-0.5 rounded-full bg-blue-500/15 border border-blue-500/30 text-blue-400 text-[11px] font-black uppercase tracking-wider flex items-center gap-1 shadow-sm shadow-blue-500/10">
          <span>⏱</span>
          <span>Tempo Oficial (7 min)</span>
        </span>
      ) : (
        <span class="px-2.5 py-0.5 rounded-full bg-gray-500/15 border border-gray-500/30 text-gray-400 text-[11px] font-black uppercase tracking-wider">
          Partida Concluída
        </span>
      )}
    </div>

    <div class="text-[11px] text-gray-400 font-semibold flex items-center gap-1.5">
      <span>⏱ {formatMinutes(match.durationSeconds)}</span>
      {match.startedAt && <span>• {formatTime(match.startedAt)}</span>}
    </div>
  </div>

  <!-- Placar Central dos 2 Times -->
  <div class="flex items-center justify-between gap-2.5 py-3 px-3.5 rounded-2xl bg-surface-200/60 border border-white/5 group-hover:bg-surface-200/90 transition-colors">
    <!-- Time Mandante -->
    <div class="flex-1 min-w-0 flex items-center gap-2.5 justify-start">
      <div
        class="w-4 h-8 rounded-md shadow shrink-0"
        style={`background-color: ${match.homeTeamColor || '#1f2937'}; border: 1px solid rgba(255,255,255,0.2);`}
      ></div>
      <div class="min-w-0">
        <h4 class:list={[
          'font-display font-black text-sm sm:text-base truncate',
          isHomeWinner ? 'text-white font-extrabold' : 'text-gray-300',
        ]}>
          {match.homeTeamName}
        </h4>
        {isHomeWinner && (
          <span class="text-[10px] font-black text-emerald-400 uppercase tracking-wider block">
            Vencedor
          </span>
        )}
      </div>
    </div>

    <!-- Placar Central (Nunca recortado ou ocultado) -->
    <div class="shrink-0 px-2 flex items-center justify-center">
      <div class="font-display font-black text-2xl sm:text-3xl text-white tracking-tight flex items-center gap-1.5 whitespace-nowrap">
        <span data-home-score class:list={[isHomeWinner ? 'text-emerald-400' : 'text-white']}>{homeScore}</span>
        <span class="text-xs text-gray-500 font-normal">x</span>
        <span data-away-score class:list={[isAwayWinner ? 'text-emerald-400' : 'text-white']}>{awayScore}</span>
      </div>
    </div>


    <!-- Time Visitante -->
    <div class="flex-1 min-w-0 flex items-center gap-2.5 justify-end text-right">
      <div class="min-w-0">
        <h4 class:list={[
          'font-display font-black text-sm sm:text-base truncate',
          isAwayWinner ? 'text-white font-extrabold' : 'text-gray-300',
        ]}>
          {match.awayTeamName}
        </h4>
        {isAwayWinner && (
          <span class="text-[10px] font-black text-emerald-400 uppercase tracking-wider block">
            Vencedor
          </span>
        )}
      </div>
      <div
        class="w-4 h-8 rounded-md shadow shrink-0"
        style={`background-color: ${match.awayTeamColor || '#ef4444'}; border: 1px solid rgba(255,255,255,0.2);`}
      ></div>
    </div>
  </div>

  <!-- Seção de Gols e Assistências dos 2 Times -->
  {hasEvents ? (
    <div class="mt-3 pt-3 border-t border-white/5 grid grid-cols-2 gap-3 text-xs">
      <!-- Gols Mandante -->
      <div class="space-y-1.5 min-w-0">
        {homeEvents.length > 0 ? (
          homeEvents.map((ev) => (
            <div class="flex items-center gap-1.5 text-gray-300 truncate" title={ev.isOwnGoal ? 'Gol Contra' : `${ev.scorerName || 'Gol'}${ev.assistName ? ` (Assistência: ${ev.assistName})` : ''}`}>
              <span class="shrink-0 text-sm">{ev.isOwnGoal ? '⚠️' : '⚽'}</span>
              <span class:list={[
                'font-bold truncate',
                ev.isOwnGoal ? 'text-rose-400' : 'text-white'
              ]}>
                {ev.isOwnGoal ? 'Gol Contra' : (ev.scorerName || 'Gol')}
              </span>
              {!ev.isOwnGoal && ev.assistName && (
                <span class="text-cyan-400 font-medium text-[11px] truncate">
                  ({ev.assistName})
                </span>
              )}
            </div>
          ))
        ) : (
          <div class="text-[11px] text-gray-600 italic">—</div>
        )}
      </div>

      <!-- Gols Visitante -->
      <div class="space-y-1.5 min-w-0 text-right">
        {awayEvents.length > 0 ? (
          awayEvents.map((ev) => (
            <div class="flex items-center justify-end gap-1.5 text-gray-300 truncate" title={ev.isOwnGoal ? 'Gol Contra' : `${ev.scorerName || 'Gol'}${ev.assistName ? ` (Assistência: ${ev.assistName})` : ''}`}>
              {!ev.isOwnGoal && ev.assistName && (
                <span class="text-cyan-400 font-medium text-[11px] truncate">
                  ({ev.assistName})
                </span>
              )}
              <span class:list={[
                'font-bold truncate',
                ev.isOwnGoal ? 'text-rose-400' : 'text-white'
              ]}>
                {ev.isOwnGoal ? 'Gol Contra' : (ev.scorerName || 'Gol')}
              </span>
              <span class="shrink-0 text-sm">{ev.isOwnGoal ? '⚠️' : '⚽'}</span>
            </div>
          ))
        ) : (
          <div class="text-[11px] text-gray-600 italic">—</div>
        )}
      </div>
    </div>
  ) : totalGoals === 0 ? (
    <div class="mt-2.5 pt-2 border-t border-white/5 text-center">
      <span class="text-[11px] text-gray-500 italic">0 x 0 • Sem gols registrados</span>
    </div>
  ) : null}

  <!-- Footer do Card: Indicativo Sutil para Ver Detalhes e Escalações -->
  <div class="mt-3.5 pt-3 border-t border-white/5 flex items-center justify-between text-[11px] text-gray-400 group-hover:text-emerald-400 transition-colors">
    <span class="flex items-center gap-1.5 font-semibold">
      <span class="text-xs">👥</span>
      <span>Ver escalações e detalhes</span>
    </span>
    <span class="text-xs font-bold text-gray-500 group-hover:text-emerald-400 group-hover:translate-x-1 transition-all duration-200">
      Ver mais →
    </span>
  </div>
</div>

<script>
  function setupMatchCardTriggers() {
    document.querySelectorAll<HTMLElement>('[data-match-card]').forEach((card) => {
      if ((card as any).__matchBound) return;
      (card as any).__matchBound = true;

      const triggerOpen = () => {
        const matchId = card.dataset.matchId;
        if (matchId) {
          window.dispatchEvent(
            new CustomEvent('open-match-details', { detail: { matchId } })
          );
        }
      };

      card.addEventListener('click', triggerOpen);
      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          triggerOpen();
        }
      });
    });
  }

  // Sincroniza placar instantaneamente quando uma súmula é editada no modal
  function setupMatchUpdatedListener() {
    if ((window as any).__matchUpdatedBound) return;
    (window as any).__matchUpdatedBound = true;

    window.addEventListener('match-updated', (e: Event) => {
      const customEv = e as CustomEvent<{ matchId?: string; homeScore?: number; awayScore?: number }>;
      if (!customEv.detail?.matchId) return;

      const card = document.querySelector<HTMLElement>(`[data-match-card][data-match-id="${customEv.detail.matchId}"]`);
      if (card) {
        const hSpan = card.querySelector('[data-home-score]');
        const aSpan = card.querySelector('[data-away-score]');
        if (hSpan && customEv.detail.homeScore !== undefined) {
          hSpan.textContent = String(customEv.detail.homeScore);
        }
        if (aSpan && customEv.detail.awayScore !== undefined) {
          aSpan.textContent = String(customEv.detail.awayScore);
        }
      }
    });
  }

  // Executa no carregamento e após transições do Astro
  setupMatchCardTriggers();
  setupMatchUpdatedListener();
  document.addEventListener('astro:page-load', () => {
    setupMatchCardTriggers();
    setupMatchUpdatedListener();
  });
</script>

