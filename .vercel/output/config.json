{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/leaderboard/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/matches/start/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/matches/([^/]+?)/finish/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/matches/([^/]+?)/goals/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/players/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/sessions/([^/]+?)/transfer/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/sessions/?$",
			"dest": "_render"
		},
		{
			"src": "^/historico/?$",
			"dest": "_render"
		},
		{
			"src": "^/rodada/mesario/?$",
			"dest": "_render"
		},
		{
			"src": "^/rodada/nova/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}