{
  "name": "society-tracker",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "vercel-build": "npm run check && npm test && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro sync && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check:astro": "astro check",
    "lint": "eslint .",
    "db:status": "node scripts/db.mjs status",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:mark-applied": "node scripts/db.mjs mark-applied",
    "db:diff": "node scripts/db.mjs diff",
    "db:grants": "node scripts/db.mjs grants",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" \"*.{js,mjs,ts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" \"*.{js,mjs,ts}\""
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@astrojs/vercel": "^11.0.5",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.2",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.3",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.2.1"
  }
}
